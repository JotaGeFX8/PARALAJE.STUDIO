{
  "name": "umbra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:start": "npx supabase@3.0.0 start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:reset": "npx supabase@3.0.0 db reset",
    "test:e2e": "node tests/e2e/run-all.mjs",
    "test:security": "bash supabase/tests/run.sh",
    "test": "npm run typecheck && npm run lint && npm run test:security",
    "db:types": "npx supabase@3.0.0 gen types typescript --local --schema public > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
