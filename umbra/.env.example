# Copia este archivo como .env.local y rellena los valores.
# Supabase → Project Settings → API Keys (o el botón «Connect» del panel).

# URL pública del proyecto Supabase (segura para el navegador).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave pública («publishable», o la antigua «anon»). Segura para el navegador:
# la seguridad real la aplica Row Level Security en la base de datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL pública del sitio (para enlaces de confirmación y recuperación).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nombre de la plataforma (provisional). Cámbialo aquí o en Vercel. Ver docs/RENOMBRAR.md.
NEXT_PUBLIC_BRAND_NAME=UMBRA

# --- Solo para vistas previas especiales (déjalas vacías en producción) ---
# Permite mostrar la web dentro de un marco (iframe) de una herramienta de vista previa.
# ALLOW_FRAMING=1
# Dominios extra desde los que se aceptan formularios (proxy de vista previa).
# SERVER_ACTIONS_ALLOWED_ORIGINS=preview.ejemplo.com

# NUNCA pongas aquí la clave «secret» / «service_role».
# La aplicación no la necesita y jamás debe llegar al navegador ni a GitHub.
