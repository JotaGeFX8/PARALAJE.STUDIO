# Copia este archivo como .env.local y rellena los valores.
# Supabase → Project Settings → API (o "Connect" en el panel del proyecto).

# URL pública del proyecto Supabase (segura para el navegador).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave pública ("publishable" o "anon"). Segura para el navegador:
# la seguridad real la aplica Row Level Security en la base de datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL pública del sitio (para enlaces de confirmación y recuperación).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NUNCA pongas aquí la clave "secret" / "service_role".
# No se necesita en esta fase y jamás debe llegar al navegador ni a GitHub.
